# Domain served by NGINX.
# Must match: the CN in the TLS certificate, server_name in nginx.conf,
# and the /etc/hosts entry on the VM.
DOMAIN_NAME=afontele.42.fr

# --- MariaDB ---
# Non-secret identifiers only. Passwords live in ../secrets/ and reach the
# containers as files under /run/secrets/, never as environment variables.
MYSQL_DATABASE=wordpress
MYSQL_USER=wpuser

# --- WordPress ---
# Usernames and emails only.
# The admin login must not contain admin / Admin / administrator as a
# substring (as per subject).
WP_ADMIN_USER=afontele
WP_ADMIN_EMAIL=afontele@student.42.fr
WP_USER=amanda
WP_USER_EMAIL=amandafprojetos@gmail.com
WP_TITLE=Inception